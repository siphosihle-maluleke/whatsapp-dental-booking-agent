        {
          "id": "8789d39c5575405185b42958",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Welcome to {{practice}}'s Digital Triage Desk. 🏥"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "gfr2jzn9a2az9yyvnynz8uto",
          "type": "text",
          "content": {
            "richText": [
              {
                "id": "wtrv_wmaHY",
                "type": "p",
                "children": [
                  {
                    "text": "How can we help you today? Are you visiting us for the first time, or have you been here before? "
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "35bd2ad4fc8a4bae8b2d76dd",
          "type": "choice input",
          "items": [
            {
              "id": "24b6a2c856274e6298e8dffe",
              "outgoingEdgeId": "edge_new",
              "content": "I'm a new patient"
            },
            {
              "id": "20d44a57bed94aebbedbf3db",
              "outgoingEdgeId": "edge_exist",
              "content": "I've been here before"
            }
          ],
          "options": {
            "variableId": "var_patient_type"
          }
        }
      ]
    },
    {
      "id": "6c42499be0314bc28966b4fd",
      "title": "POPIA Consent (New)",
      "graphCoordinates": {
        "x": -86.69,
        "y": -191.63
      },
      "blocks": [
        {
          "id": "9d4774d0d0d0409cae41608d",
          "type": "text",
          "content": {
            "richText": [
              {
                "id": "jFLDXZWXuE",
                "type": "p",
                "children": [
                  {
                    "text": "Since it's your first time, please note we collect your name and contact details to manage your booking. Your information is stored securely in compliance with the South African POPIA Act and is never shared. Do you consent to proceed?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "8af53af4f3444e0b95320492",
          "type": "choice input",
          "items": [
            {
              "id": "a94011b412ae436e852875f3",
              "outgoingEdgeId": "edge_consent_yes",
              "content": "Yes, I consent"
            },
            {
              "id": "86c5ef4adf0a4a899dcec0a4",
              "outgoingEdgeId": "edge_consent_no",
              "content": "No, thank you"
            }
          ]
        }
      ]
    },
    {
      "id": "1890c0d4684f492ea7eef51b",
      "title": "Opt Out",
      "graphCoordinates": {
        "x": 396.27,
        "y": 61.24
      },
      "blocks": [
        {
          "id": "a046d0da5529451ca2bfeb73",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Understood. Privacy is paramount. Please call our reception directly at {{practice_phone}} to book manually."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
