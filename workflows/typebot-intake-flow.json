          "content": {
            "url": "https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID/exec?name={{name}}&phone={{phone_number}}&service={{service_type}}&practice={{practice}}&practice_phone={{practice_phone}}",
