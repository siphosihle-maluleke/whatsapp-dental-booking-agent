            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Alright, {{name}}, you are all set! ✅ I've provisionally locked in your consultation for **{{booked_slot}}**."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "04102f20bd254866b58210db",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "You'll receive an automated WhatsApp reminder ahead of your visit. Feel better soon! 🌿"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "8d4c55f724c44afbbd8cd101",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "⚡ **Note for Practice Manager:** Captured in {{seconds}} seconds. That's how fast your patients will book! Head back to WhatsApp to discuss integration."
