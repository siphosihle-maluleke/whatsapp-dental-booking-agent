      "blocks": [
        {
          "id": "fb3409d9d3f7496889628952",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "I'm so sorry you're not feeling well. 😔 Just to be safe: If you are experiencing a severe emergency, please dial 112 or head to the ER."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "572bb6ac6d2846d8824f6cbd",
          "outgoingEdgeId": "e_urg_to_pay",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "If it's urgent but not life-threatening, let's prioritize your booking right now."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
