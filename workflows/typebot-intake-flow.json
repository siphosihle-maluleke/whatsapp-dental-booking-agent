    {
      "id": "405351a2e8cf4907b6e23089",
      "title": "Finish & Save",
      "graphCoordinates": {
        "x": 2636.27,
        "y": -95.41
      },
      "blocks": [
        {
          "id": "956002e8dc7d4d7ab4bc39ea",
          "type": "Google Sheets",
          "options": {
