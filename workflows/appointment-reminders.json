    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "YOUR_GOOGLE_CALENDAR_ID",
          "mode": "list",
          "cachedResultName": "Clinic Calendar"
        },
        "options": {
          "timeMin": "={{ $now.plus({ hours: 23, minutes: 30 }).toISO() }}",
          "timeMax": "={{ $now.plus({ hours: 24 }).toISO() }}",
          "singleEvents": true
        }
      },
      "id": "9f11cb30-a095-418e-b1e4-12fd35aafaba",
      "name": "Get Appointments (In 24h)",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        416,
        -256
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const desc = item.json.description || '';\n  const phoneMatch = desc.match(/Phone:\\s*([+\\d\\s()-]+)/i);\n  const nameMatch = desc.match(/Client:\\s*(.+)/i);\n  if (!phoneMatch) continue;\n\n  const rawPhone = phoneMatch[1].trim();\n  if (!rawPhone) continue;\n\n  const firstName = nameMatch ? nameMatch[1].trim().split(' ')[0] : 'there';\n  const startRaw = item.json.start?.dateTime || item.json.start?.date;\n  const startTime = startRaw\n    ? new Date(startRaw).toLocaleTimeString('en-ZA', {\n        hour: '2-digit',\n        minute: '2-digit',\n        timeZone: 'Africa/Johannesburg'\n      })\n    : 'your scheduled time';\n\n  results.push({\n    json: {\n      phone: rawPhone,\n      name: firstName,\n      time: startTime\n    }\n  });\n}\nreturn results;"
      },
      "id": "ed8b7029-9a2c-49b2-a377-983e79d15a1f",
      "name": "Extract Client & Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        -256
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_WHATSAPP_GATEWAY_HOST:3001/send-message",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"secret\": \"YOUR_INTERNAL_WEBHOOK_SECRET\",\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": \"Hi {{ $json.name }}! Just a friendly reminder of your appointment tomorrow at {{ $json.time }} with CarePoint Dental Clinic. Reply YES to confirm or let us know if you need to reschedule.\"\n}",
        "options": {}
      },
      "id": "2d2fbc60-afc2-4ef3-8d52-e6a3bf8195d2",
